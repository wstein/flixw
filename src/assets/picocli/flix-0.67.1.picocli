// Realistic picocli-spec DSL for the real flix CLI (v0.67.1, covering v0.67.1 - v0.67.2), based
// on structural analysis of flix's own scopt-based parser (Main.scala) and Bootstrap.scala at git
// tag v0.67.1.
//
// Key changes in this version:
// 1. Introduces the 'format' command ("formats Flix source code files.").
// 2. Restricts file arguments: Main.scala now explicitly validates that only check, doc, format,
//    and test accept file arguments ("The '...' command does not support file arguments." on all others).
// 3. Removes --args in favor of the standard '--' passthrough separator for 'run'.
// 4. Removes 4 experimental flags (Xfuzzer, Xprint-typer, Xchaos-monkey, Xiterations), leaving 10.
// 5. Keeps --json top-level (only consulted for --version --json).
//
// Standard help/version options are provided via mixinStandardHelpOptions and genuinely short-circuit execution.
// Shared options/positionals are declared once in definitions { ... } and pulled in via "use".

definitions {
  option --explain : boolean "provides suggestions on how to solve a problem."
  option --github-token : String "API key to use for GitHub dependency resolution."
  option --no-install : boolean "disables automatic installation of dependencies."
  option --threads : int "number of threads to use for compilation."
  option --entrypoint : String "specifies the main entry point."
  option --yes : boolean "automatically answer yes to all prompts."

  // Not part of real flix's own --help; this proxy's own addition, paired with hiding the
  // --X* flags from standard help. Triggers rendering of the "experimental" help section.
  option --Xhelp : boolean "shows the experimental options for this command." helpSection="experimental"

  option --Xbenchmark-code-size : boolean "[experimental] benchmarks the size of the generated JVM files."
  option --Xbenchmark-incremental : boolean "[experimental] benchmarks the performance of each compiler phase in incremental mode."
  option --Xbenchmark-phases : boolean "[experimental] benchmarks the performance of each compiler phase."
  option --Xbenchmark-frontend : boolean "[experimental] benchmarks the performance of the frontend."
  option --Xbenchmark-throughput : boolean "[experimental] benchmarks the performance of the entire compiler."
  option --Xlib : String "[experimental] controls the amount of std. lib. to include (nix, min, all)."
  option --Xno-deprecated : boolean "[experimental] disables deprecated features."
  option --Xprint-phases : boolean "[experimental] prints the ASTs after the each phase."
  option --Xsummary : boolean "[experimental] prints a summary of the compiled modules."
  option --Xsubeffecting : String "[experimental] enables sub-effecting in select places"

  // Main.scala reads cmdOpts.xbenchmark* exclusively inside `case Command.None =>` (before
  // dispatching to any subcommand) -- these five are silently inert if attached to check/build/
  // run/test or any other subcommand. So, unlike xflags below, they're bundled separately and
  // attached only to the root `flix` command, never via devLoop.
  bundle xbenchmarkFlags {
    group cooperative helpSection="experimental" "The following options are experimental:%n" {
      option --Xbenchmark-code-size
      option --Xbenchmark-incremental
      option --Xbenchmark-phases
      option --Xbenchmark-frontend
      option --Xbenchmark-throughput
    }
  }

  // 10 experimental flags for this version (Xfuzzer, Xprint-typer, Xchaos-monkey, and
  // Xiterations removed in v0.67.1; split 5/5 with xbenchmarkFlags above). Unlike
  // xbenchmarkFlags, these five flow through `options` into flix.check()/flix.compile() for
  // every command that compiles, so devLoop's check/build/run/test scoping is a curation
  // choice, not a hard restriction the way xbenchmarkFlags's root-only placement is.
  bundle xflags {
    group cooperative helpSection="experimental" "The following options are experimental:%n" {
      option --Xlib
      option --Xno-deprecated
      option --Xprint-phases
      option --Xsummary
      option --Xsubeffecting
    }
  }

  // Only check, doc, format, and test accept file arguments as a named subcommand in this
  // version; the root `flix` command (case Command.None) separately accepts files directly too
  // (compiles and runs them with no `run` subcommand needed, when at least one is given).
  positional files : Path[] "input Flix source code files, Flix packages, and Java archives." arity=0..*

  bundle dependencyResolution {
    option --github-token
    option --no-install
  }

  bundle compileOptions {
    use dependencyResolution
    option --threads
  }

  bundle devLoop {
    use compileOptions
    option --explain
    option --Xhelp
    use xflags
  }
}

command flix "The Flix Programming Language 0.67.1" {
  mixinStandardHelpOptions
  section experimental "The following options and commands are experimental:%n" emptyMessage="No experimental options for this command."
  option --json : boolean "enables json output."
  option --listen : int "starts the socket server and listens on the given port."

  // Confirmed (Main.scala): case Command.None is the only branch that reads cmdOpts.files or any
  // --Xbenchmark-* flag. With no files, it starts a REPL; with files, it compiles and runs them
  // directly (no `run` subcommand needed). So this positional and xbenchmarkFlags belong only on
  // the root command, not on any subcommand.
  option --Xhelp
  use xbenchmarkFlags
  positional files

  command init "creates a new project in the current directory." {}

  command check "checks the current project for errors." {
    use devLoop
    positional files
  }

  command build "builds (i.e. compiles) the current project." {
    use devLoop
  }

  command build-jar "builds a jar-file from the current project." {
    option --entrypoint
    use compileOptions
  }

  command build-fatjar "builds a fatjar-file from the current project." {
    option --entrypoint
    use compileOptions
  }

  command build-pkg "builds a fpkg-file from the current project." {
    use compileOptions
  }

  command clean "recursively removes class files from the build directory." {
    use dependencyResolution
  }

  command doc "generates API documentation." {
    use compileOptions
    positional files
  }

  command format "formats Flix source code files." {
    use compileOptions
    positional files
  }

  command run "runs main for the current project." {
    use devLoop
    option --entrypoint
  }

  command test "runs the tests for the current project." {
    use devLoop
    positional files
  }

  command repl "starts a repl for the current project, or provided Flix source files." {
    use compileOptions
  }

  command lsp "starts the Plain-LSP server." {}

  command lsp-vscode "starts the VSCode-LSP server and listens on the given port." {
    positional port : int "the port to listen on." required
  }

  command release "releases a new version to GitHub." {
    use compileOptions
    option --yes
  }

  command outdated "shows dependencies which have newer versions available." {
    use dependencyResolution
  }
}
