# over from the pre-restructure Scala scaffold -- for the whole life of the project.
/services/target/
/services/lib_managed/
/services/src_managed/
/services/local.sbt
/services/.history
/services/project/target/
/services/project/project/
/services/project/boot/
/services/project/local-plugins.sbt

